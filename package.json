{
  "name": "cloudy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:pages": "tsc --noEmit -p tsconfig.json && vite build --base=/cloudy/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "preview:pages": "npm run build:pages && vite preview --base=/cloudy/ --host 127.0.0.1 --port 43202 --strictPort",
    "verify": "node scripts/verify.mjs",
    "tla": "node scripts/tla.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "box2d3-wasm": "6.0.0",
    "lil-gui": "0.21.0",
    "motion": "14.9.0",
    "simplex-noise": "4.0.3",
    "three": "0.187.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "agent-browser": "^0.41.1",
    "fast-check": "^4.10.2",
    "happy-dom": "20.14.5",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
